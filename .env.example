# SignSpeak V2 Production Configuration

# Camera Settings
CAMERA_INDEX=0
MAX_HANDS=1
DETECTION_CONFIDENCE=0.7
TRACKING_CONFIDENCE=0.5

# Inference Pipeline Settings
FRAME_BUFFER_SIZE=5
CONFIDENCE_THRESHOLD=0.4
LETTER_HOLD_FRAMES=3
LETTER_COOLDOWN_MS=200

# Model Settings
MODEL_PATH=models/landmark_mlp_recorded.joblib
GPU_ENABLED=true

# Server Settings
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/signspeak.log

# Frame Processing
FRAME_RATE=0.1
